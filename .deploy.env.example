# Copy to .deploy.env (not committed) and fill in for `npm run deploy`.
# Needs SSH access to Home Assistant, e.g. the "Advanced SSH & Web Terminal" add-on with your
# public key added to its authorized_keys.

HA_HOST=homeassistant.local
HA_USER=root
HA_PORT=22
# HA_CONFIG=/config
# Where the card is installed. Default is the HACS folder; use $HA_CONFIG/www for /local/zappi-card.js.
# HA_CARD_DIR=/config/www/community/ha_zappisstant
