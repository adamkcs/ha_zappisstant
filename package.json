{
  "name": "zappi-card",
  "version": "0.1.2",
  "description": "Home Assistant dashboard card for controlling a myenergi zappi EV charger",
  "type": "module",
  "main": "dist/zappi-card.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && echo 'Preview: http://127.0.0.1:5173/dev/preview.html' && python3 -m http.server 5173 --bind 127.0.0.1",
    "deploy": "bash scripts/deploy.sh"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "myenergi",
    "zappi"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "rollup": "^4.68.2",
    "tslib": "^2.9.1",
    "typescript": "~5.9.3"
  }
}
